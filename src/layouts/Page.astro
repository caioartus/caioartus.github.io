---
// Layout for plain Markdown pages in src/pages/ (e.g. about.md).
// Use it with `layout: ../layouts/Page.astro` in the page's frontmatter.
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const { title, description } = Astro.props.frontmatter;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} · ${SITE_TITLE}`} description={description ?? title} />
	</head>
	<body>
		<Header />
		<main>
			<h1>{title}</h1>
			<slot />
		</main>
		<Footer />
	</body>
</html>
