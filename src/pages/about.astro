---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { GITHUB_URL, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About · ${SITE_TITLE}`} description={`About ${SITE_TITLE}`} />
	</head>
	<body>
		<Header />
		<main>
			<h1>About me</h1>

			<!-- TODO: write your intro -->
			<p>Hi, I'm {SITE_TITLE}. [A sentence or two about who you are and what you do.]</p>

			<h2>What I work on</h2>
			<!-- TODO: your interests, current focus, stack -->
			<p>[What you build, what you're into, what this blog is about.]</p>

			<h2>Elsewhere</h2>
			<ul>
				<li><a href={GITHUB_URL} target="_blank">GitHub</a></li>
				<!-- TODO: add LinkedIn, X, email, etc. -->
			</ul>
		</main>
		<Footer />
	</body>
</html>
